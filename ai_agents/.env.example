# API Keys & Credentials for AI Agents

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── GitHub (Pipeline Agent) ──────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token   # needs: repo, workflow scopes
GITHUB_REPOSITORY=owner/repo-name               # e.g. my-org/azure-landing-zone
MAX_RETRIES=3                                    # pipeline agent retry cycles

# ── Azure Service Principal (all agents) ─────────────────────────────────────
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your_client_secret_here

# ── Terraform Agent ───────────────────────────────────────────────────────────
TF_MAX_RETRIES=3                                 # terraform apply retry cycles

# ── ACR (K8s/ACR Agent) ───────────────────────────────────────────────────────
ACR_NAME=myacr                                   # ACR registry name (no .azurecr.io)
ACR_LOGIN_SERVER=myacr.azurecr.io               # full login server hostname
IMAGE_NAME=myapp                                 # Docker image name
IMAGE_TAG=latest                                 # Docker image tag

# ── AKS / Kubernetes (K8s/ACR Agent) ──────────────────────────────────────────
AKS_CLUSTER_NAME=aks-dev-cluster
RESOURCE_GROUP=rg-landing-zone-dev
K8S_NAMESPACE=default
K8S_MAX_RETRIES=3                                # kubectl deploy retry cycles
